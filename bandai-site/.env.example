# Copy to .env for local development. On Vercel: Project → Settings →
# Environment Variables. In GitHub: Settings → Secrets and variables → Actions.
# There is no database and no email service: public data is committed JSON.

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=

# eBay Browse API (developer.ebay.com → Application Keys, Production) — GitHub secrets
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# This site's share of the app's 5,000 daily calls is SITE.ebay.dailyBudget (1,500)
# eBay Marketplace Account Deletion endpoint token (32-80 chars, same on eBay) — Vercel
EBAY_VERIFICATION_TOKEN=

# Affiliates
# The EPN campaign (5339155912) is hard-coded in src/lib/affiliate.ts; no variable.
TCGPLAYER_IMPACT_LINK=https://partner.tcgplayer.com/c/7385758/1780961/21018

# Ads (future; nothing renders until a slot id is set)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=

# Search engines
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
INDEXNOW_KEY=
