# MTG Compare - copy to .env for local development. Every variable the code reads is a row of
# tests/fixtures/env-names.json (tests/env-names.test.ts); this file lists each of them.
#
# Where a value lives: V = Vercel project environment variables, PRODUCTION SCOPE ONLY (preview
# deployments are off: no Preview scope, no Development scope); G = GitHub Actions secret or
# variable of Specifxx/mtgcompare; local = your machine only. A secret is never committed:
# the examples below are placeholders. Uncomment a line to set it.
#
# MTG Compare has its OWN Neon project, Vercel project, Stripe account (inside the owner's
# RiftCompare organisation), eBay keyset and mailbox - never RiftCompare's, never OP Compare's.


# ---- Database and platform ----
# [secret, Vercel (Production only) and GitHub Actions] the ONE Neon project (pooled URL): private tables only (accounts, billing, watches, alerts, collection, notifications, newsletter, inbox, click events, ledger and eBay data, ImportRun/Meta). Public data is NOT in it (section...
DATABASE_URL="postgresql://mtg:mtg@localhost:5432/mtgcompare"
# [test, local development only] DB-backed tests skip when unset (C23)
# TEST_DATABASE_URL=""
# [test, local development only] directory of the research snapshot (scryfall/, tcgcsv/, design/magic-tools/ts-check/); the corpus tests skip when unset
# MTG_LAB=""
# [secret, GitHub Actions] the NEW Neon project of the maintenance task migrate-database (pg_restore target; private tables only). Read by the workflow alone; never a Vercel variable
# TARGET_DATABASE_URL=""
# [var, Vercel (Production only)]
# PRISMA_LOG=""
# [var, GitHub Actions] importer heap
# NODE_OPTIONS="--max-old-space-size=3072"

# ---- Site identity and links ----
# [public, Vercel (Production only)] the domain (10.3); read in ONE file
NEXT_PUBLIC_SITE_URL="https://mtgcompare.app"
# [var, GitHub Actions] production origin for scripts and the importer's User-Agent
# SITE_URL=""
# [public, Vercel (Production only)] ONE contact address (requirements 1.4). The default ends in .invalid on purpose: a placeholder on a real domain would deliver every mailto to whoever owns it (WP16-site-identity-and-legal-strings)
# NEXT_PUBLIC_CONTACT_EMAIL="riftcompare@gmail.com"
# [public, Vercel (Production only)]
# NEXT_PUBLIC_DISCORD_URL=""
# [public, Vercel (Production only)]
# NEXT_PUBLIC_ANON_ALERTS=""
# [public, Vercel (Production only)] static fallback exchange rate
# NEXT_PUBLIC_USD_TO_AUD="built-in"
# [public, Vercel (Production only)] static fallback exchange rate
# NEXT_PUBLIC_USD_TO_CAD="built-in"
# [public, Vercel (Production only)] static fallback exchange rate
# NEXT_PUBLIC_USD_TO_EUR="built-in"
# [public, Vercel (Production only)] static fallback exchange rate
# NEXT_PUBLIC_USD_TO_GBP="built-in"
# [public, Vercel (Production only)] static fallback exchange rate
# NEXT_PUBLIC_USD_TO_SGD="built-in"
# [public, Vercel (Production only)] scryfall flips the front-image order (10.4)
# NEXT_PUBLIC_IMAGE_PRIMARY="tcgplayer"

# ---- Affiliate links ----
# [public, Vercel (Production only) and GitHub Actions] EPN campaign id, MTG's own (10.20). Replaces OP's EBAY_AFFILIATE_CAMPAIGN, which client components could not read (no NEXT_PUBLIC prefix) and which fell back to RIFT's id 5339155912 in the browser
# NEXT_PUBLIC_EBAY_CAMPAIGN_ID=""
# [public, Vercel (Production only)] Impact link. Replaces OP's TCGPLAYER_IMPACT_LINK (default was Rift's partner link)
# NEXT_PUBLIC_TCGPLAYER_IMPACT_LINK=""
# [public, Vercel (Production only)]
# NEXT_PUBLIC_TCGPLAYER_CREATIVES=""
# [var, Vercel (Production only)] per-market EPN tracking parameter (templated read)
# EBAY_MKRID_US="built-in"
# [var, Vercel (Production only)] per-market EPN site id (templated read)
# EBAY_SITEID_US="built-in"
# [var, Vercel (Production only)] per-market EPN tracking parameter (templated read)
# EBAY_MKRID_AU="built-in"
# [var, Vercel (Production only)] per-market EPN site id (templated read)
# EBAY_SITEID_AU="built-in"
# [var, Vercel (Production only)] per-market EPN tracking parameter (templated read)
# EBAY_MKRID_UK="built-in"
# [var, Vercel (Production only)] per-market EPN site id (templated read)
# EBAY_SITEID_UK="built-in"
# [var, Vercel (Production only)] per-market EPN tracking parameter (templated read)
# EBAY_MKRID_CA="built-in"
# [var, Vercel (Production only)] per-market EPN site id (templated read)
# EBAY_SITEID_CA="built-in"
# [var, Vercel (Production only)] per-market EPN tracking parameter (templated read)
# EBAY_MKRID_SG="built-in"
# [var, Vercel (Production only)] per-market EPN site id (templated read)
# EBAY_SITEID_SG="built-in"
# [var, Vercel (Production only)] per-market EPN tracking parameter (templated read)
# EBAY_MKRID_EU="built-in"
# [var, Vercel (Production only)] per-market EPN site id (templated read)
# EBAY_SITEID_EU="built-in"

# ---- Accounts, billing, admin ----
# [secret, Vercel (Production only) and GitHub Actions] session signing; also verifies signed email links in scripts
AUTH_SECRET="change-me"
# [var, Vercel (Production only)]
# ADMIN_EMAILS="mastermisclick@gmail.com"
# [secret, Vercel (Production only)] scripts only, Authorization: Bearer, at least 32 characters
# ADMIN_TOKEN=""
# [var, Vercel (Production only)] extra origins (comma separated) an admin POST may come from in production, besides SITE_URL: a preview domain you administer from
# ADMIN_EXTRA_ORIGINS=""
# [var, Vercel (Production only)]
# GOOGLE_CLIENT_ID=""
# [secret, Vercel (Production only)]
# GOOGLE_CLIENT_SECRET=""
# [var, Vercel (Production only)]
# DISCORD_CLIENT_ID=""
# [secret, Vercel (Production only)]
# DISCORD_CLIENT_SECRET=""
# [secret, Vercel (Production only) and GitHub Actions] the NEW MTG Compare Stripe account (test mode first). The site tag `site=mtgcompare` and the lookup keys `mtgcompare_*` are constants in plans.ts, not variables
# STRIPE_SECRET_KEY=""
# [secret, Vercel (Production only)]
# STRIPE_WEBHOOK_SECRET=""
# [secret, Vercel (Production only) and GitHub Actions] bearer secret: Vercel cron routes, the warm call /api/data-warm that every publish makes, and the purge of the Neon-backed tags /api/revalidate. Plane data needs no purge (pinned URLs)
CRON_SECRET="change-me"
# [var, GitHub Actions] production origin: /api/data-warm and /api/data-status are called after every publish, /api/revalidate only for the Neon-backed tags
# REVALIDATE_URL=""
# [secret, Vercel (Production only)] OPTIONAL fine-grained token, this repository only, Actions: write. Lets /admin/ebay and /admin/deploys dispatch a workflow. NOT an eBay credential
# GITHUB_DISPATCH_TOKEN=""
# [public, Vercel (Production only)] owner/repo used by the admin links and the unauthenticated release-history read
# NEXT_PUBLIC_GITHUB_REPO="Specifxx/mtgcompare"
# [var, Vercel (Production only)] 0 = outbound clicks are not recorded (owner decision 10.32); GA's buy_click is unaffected. Clicks are buffered in the instance and written in ONE insert inside the aligned half-hour window shared with the view counter...
# CLICK_LOG="1"
# [var, Vercel (Production only)] 1 = every click (buffered); 0.1 = one in ten. Read only by ClickBatcher's caller
# CLICK_SAMPLE_RATE="1"

# ---- Email and notifications ----
# [var, GitHub Actions]
# EMAIL_FROM=""
# [var, GitHub Actions]
# EMAIL_REPLY_TO=""
# [secret, Vercel (Production only) and GitHub Actions] signs unsubscribe and action links
# EMAIL_LINK_SECRET=""
# [secret, GitHub Actions] script-side only (tests/no-email-api.test.ts)
# RESEND_API_KEY=""
# [secret, GitHub Actions]
# BREVO_API_KEY=""
# [var, GitHub Actions] distinct addresses mailed per rolling day, free and paid runs together (price-alerts.ts alertDailyBudget)
# ALERT_DAILY_BUDGET="built-in"
# [secret, GitHub Actions] Discord/Slack webhook for freshness, failure and store-health alerts (parity P39). Webhook only, no bot
# OPS_WEBHOOK_URL=""

# ---- Analytics and search engines ----
# [public, Vercel (Production only)]
# NEXT_PUBLIC_GA_ID=""
# [public, Vercel (Production only)]
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
# [var, Vercel (Production only)]
# GOOGLE_SITE_VERIFICATION=""
# [var, Vercel (Production only)]
# BING_SITE_VERIFICATION=""
# [var, Vercel (Production only) and GitHub Actions]
# INDEXNOW_KEY=""
# [var, GitHub Actions]
# GSC_PROPERTY="sc-domain:<domain>"
# [secret, GitHub Actions]
# GSC_SA_KEY=""

# ---- eBay (script-side only; the credentials are GitHub Actions secrets, never Vercel) ----
# [secret, GitHub Actions] tests/no-ebay-api.test.ts: named only in src/lib/ebay*.ts and ebay-prices.yml. The workflow file name is ebay-prices.yml (one name, everywhere)
# EBAY_CLIENT_ID=""
# [secret, GitHub Actions]
# EBAY_CLIENT_SECRET=""
# [var, GitHub Actions] shared (Rift first, then MTG on the same quota) or own (10.1)
# EBAY_KEYSET_MODE="shared"
# [var, GitHub Actions] quota reads only (10.2)
# EBAY_OBSERVE_ONLY="1"
# [var, GitHub Actions] KILL SWITCH (requirements 4): 0 = no Browse call at all
# EBAY_API_ENABLED="1"
# [var, GitHub Actions] calls per day for MTG (requirements 4); the ledger enforces it
# EBAY_DAILY_CALL_BUDGET="1000"
# [var, GitHub Actions] calls always left for Rift
# EBAY_QUOTA_RESERVE="OP's"
# [var, GitHub Actions] cap per run
# EBAY_MAX_CALLS="OP's"
# [var, GitHub Actions] price floor for the allocator
# EBAY_MIN_VALUE_CENTS="OP's"
# [var, GitHub Actions]
# EBAY_DISPATCH_CAP="OP's"
# [var, GitHub Actions] manual override flag
# EBAY_FORCE=""
# [var, GitHub Actions] restrict a manual run to one market
# EBAY_ONLY_MARKET=""
# [var, GitHub Actions]
# EBAY_REFRESH=""
# [secret, Vercel (Production only)] Marketplace Account Deletion route; tests/no-ebay-api.test.ts pins the two names this route reads
# EBAY_VERIFICATION_TOKEN=""
# [var, Vercel (Production only)]
# EBAY_DELETION_ENDPOINT=""

# ---- Importer and publisher (GitHub Actions variables, never Vercel variables) ----
# [var, GitHub Actions] every priced class-0 single has a row; 10, 25, 50 are the fallback ladder (5.6) (read only by trackConfigFromEnv)
# CATALOG_FLOOR_CENTS="1"
# [var, GitHub Actions] read only by trackConfigFromEnv
# CATALOG_EXIT_RATIO="0.8"
# [var, GitHub Actions] every priced oracle keeps its TOP printing listed whatever the floor (read only by trackConfigFromEnv)
# CATALOG_ORACLE_COMPLETE="1"
# [var, GitHub Actions] a listed row below this score is THIN: noindex, no sitemap entry (read only by trackConfigFromEnv)
# INDEX_FLOOR_CENTS="50"
# [var, GitHub Actions] read only by trackConfigFromEnv
# CATALOG_SPECIAL_FLOOR_CENTS="2000"
# [var, GitHub Actions] read only by trackConfigFromEnv
# TRACK_FLOOR_CENTS="500"
# [var, GitHub Actions] read only by trackConfigFromEnv
# TRACK_EXIT_RATIO="0.8"
# [var, GitHub Actions] read only by trackConfigFromEnv
# TRACK_LOW_BASIS="0"
# [var, GitHub Actions] read only by trackConfigFromEnv
# TRACK_POP_BOOST="0"
# [var, GitHub Actions] read only by trackConfigFromEnv
# TRACK_PER_ORACLE_CAP="0"
# [var, GitHub Actions] read only by trackConfigFromEnv
# PRICE_CLIP_CENTS="200000"
# [var, GitHub Actions] F6 cap (read only by trackConfigFromEnv)
# CATALOG_MAX_ROWS="200000"
# [var, GitHub Actions] F6 cap (read only by trackConfigFromEnv)
# TRACK_MAX_UNITS="70000"
# [var, GitHub Actions] section 12 may re-express it in bytes (read only by trackConfigFromEnv)
# OFFER_ROWS_BUDGET="450000"
# [var, GitHub Actions] F10 (read only by trackConfigFromEnv)
# IMPORT_MAX_LISTED_CHANGE="0.05"
# [var, GitHub Actions] F10 (read only by trackConfigFromEnv)
# IMPORT_MAX_TRACKED_CHANGE="0.15"
# [var, GitHub Actions] 1 = accept this run's flag changes once (read only by trackConfigFromEnv)
# IMPORT_ACCEPT_FLAG_CHANGE="0"
# [var, GitHub Actions] the Nth consecutive F10 trip is accepted (read only by trackConfigFromEnv)
# IMPORT_GUARD_MAX_TRIPS="3"
# [var, GitHub Actions] a parse below this fraction of the last run aborts (F2, F4)
# IMPORT_MIN_PARSE_RATIO="0.9"
# [var, GitHub Actions] off = prices-only run keeping existing links (the library reads it; the two entry points pass it on)
# SCRYFALL_MODE="auto"
# [var, GitHub Actions] 1 = ignore the last-updated.txt gate
# IMPORT_FORCE=""
# [var, GitHub Actions] 0 = skip the store stage (bootstrap sets 0)
# IMPORT_STORES="1"
# [var, GitHub Actions]
# IMPORT_ONLY_STORES=""
# [var, GitHub Actions]
# IMPORT_ONLY_COUNTRY=""
# [var, GitHub Actions] 1 = skip the warm call and the status poll after a publish (S13); the pointer has already moved
# SKIP_REVALIDATE=""
# [var, GitHub Actions] local response cache for offline re-runs
# TCGCSV_CACHE_DIR=""
# [var, local development only] ISO stamp of the TCGCSV day, used when <TCGCSV_CACHE_DIR>/last-updated.txt is absent (offline runs, the M1 bootstrap over a research download)
# TCGCSV_LAST_UPDATED=""
# [var, GitHub Actions]
# SCRYFALL_CACHE_DIR=""
# [var, local development only] test dial: the wait before the one retry after a Scryfall 429
# SCRYFALL_BACKOFF_MS="30000"
# [var, GitHub Actions] the Actions cache directory of the slim Scryfall file and the phase-1 to phase-2 match index
# IMPORT_CACHE_DIR=".cache"
# [var, GitHub Actions] N = restrict the first run to the N largest and newest groups
# BOOTSTRAP_GROUPS=""
# [var, GitHub Actions] public price feeds stay off (10.11)
# FEED_SOURCES="empty"

# ---- Data plane (section 12): where the published data lives, its reader's tuning, and (only for PLANE_BACKEND=github) the private data repository and its tokens ----
# DEFAULT SINCE 2026-10-09 (DECISIONS.md, "The plane moves into Neon"): the published tree is the "PlaneFile" table of the DATABASE_URL database. It needs NO token and none of PLANE_REPO / PLANE_BRANCH / PLANE_TOKEN / DATA_REPO_TOKEN below, which are OPTIONAL
# and read only when PLANE_BACKEND=github.
# [var, Vercel (Production only) and GitHub Actions] neon (the default, also when unset) or github. The same value in Vercel and in Actions.
# PLANE_BACKEND="neon"
# [var, Vercel (Production only)] Neon backend: how long an instance trusts its last read of the pointer row before looking again (stale-while-error on failure); raise it to let Neon's compute suspend between visits
# PLANE_POINTER_TTL_S="60"
# [var, OPTIONAL: PLANE_BACKEND=github only] owner/name of the PRIVATE data repository (12.4); the same value in Vercel and in Actions
# PLANE_REPO="Specifxx/mtgcompare-data"
# [var, OPTIONAL: PLANE_BACKEND=github only] the data branch; only the publisher writes it
# PLANE_BRANCH="data"
# [secret, OPTIONAL: PLANE_BACKEND=github only; Vercel (Production only)] fine-grained personal access token, Contents: read, on the data repository ONLY, at most 1 year (alarm 30 days before expiry). Part of the Data Cache key of every file: a rotation makes the cache cold and is followed by the...
# PLANE_TOKEN=""
# [var, local development only] development, jobs and tests: a directory that holds v1/ (and optionally latest.json); no network, no token
# PLANE_DIR=""
# [var, local development only] a git remote URL or local path that REPLACES https://github.com/<PLANE_REPO>.git: a bare repository for the drills and tests; unset in production
# PLANE_REMOTE=""
# [var, local development only] where the clones of the data repository live
# PLANE_WORK_DIR="<os"
# [var, Vercel (Production only)] per-instance memory cache of parsed files (default 64; 120 with the Neon backend)
# PLANE_LRU_MB="64"
# [var, Vercel (Production only)] per-file budget of the raw host before the API fallback
# PLANE_TIMEOUT_RAW_MS="3000"
# [var, Vercel (Production only)] per-file budget of the contents API fallback
# PLANE_TIMEOUT_API_MS="5000"
# [var, GitHub Actions] 1 = operate knowingly with a public data repository; the premium inputs and licensed data are then world-readable (12.3.3)
# PLANE_ALLOW_PUBLIC=""
# [secret, OPTIONAL: PLANE_BACKEND=github only; GitHub Actions] fine-grained personal access token, Contents: write (and Administration: read for the size probe), on the data repository ONLY. GITHUB_TOKEN covers only the workflow's own repository. Travels in an http extraheader, never in a...
# DATA_REPO_TOKEN=""
# [var, Vercel (Production only)] the card-view counter samples one view in N and never counts a crawler; 1 = every view, 0 = off (12.12)
# VIEW_BEACON_SAMPLE="10"
# [var, Vercel (Production only)] the counter writes to Neon at most this often per instance (scale-to-zero arithmetic: 12.12)
# VIEW_FLUSH_MINUTES="30"
# [test, local development only] development tooling: path of the work-package plan scripts/gen-ownership.ts turns into docs/ownership.json (the owner map the ratchets read)
# WORK_PACKAGES_JSON=""
# [test, local development only] development tooling: 1 writes docs/ownership.json although the plan has problems
# OWNERSHIP_WRITE_ANYWAY=""
