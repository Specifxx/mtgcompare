{
  "name": "dexcompare-sealed",
  "version": "1.0.0",
  "private": true,
  "description": "DexCompare — compare Pokémon TCG sealed product prices and stock across independent stores.",
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "prisma generate && next build",
    "start": "next start -p 3003",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "PUBLIC_DATA_MODE=db node --import tsx --test tests/*.test.ts",
    "db:push": "prisma db push",
    "import": "tsx scripts/import.ts",
    "probe:stores": "tsx scripts/probe-stores.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@vercel/analytics": "^1.5.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.39",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.16.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
