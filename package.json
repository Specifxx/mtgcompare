{
  "name": "mtgcompare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "import": "tsx scripts/import.ts",
    "import:bootstrap": "tsx scripts/bootstrap.ts",
    "import:catalog": "IMPORT_STORES=0 tsx scripts/import.ts",
    "probe:stores": "tsx scripts/probe-stores.ts",
    "icons": "tsx scripts/gen-icons.ts",
    "health:stores": "tsx scripts/store-health.ts",
    "audit:inbox": "tsx scripts/audit-inbox.ts",
    "check:constants": "tsx scripts/contract-checks/check-constants.ts",
    "check:catalog": "tsx scripts/contract-checks/check-catalog.ts",
    "check:images": "tsx scripts/contract-checks/check-images.ts",
    "check:track": "tsx scripts/contract-checks/check-track.ts",
    "check:policy": "tsx scripts/contract-checks/check-policy-snapshot.ts",
    "check:indexable": "python3 scripts/contract-checks/count_indexable.py",
    "check:plane-tree": "tsx scripts/contract-checks/check-plane-tree.ts",
    "check:smoke": "node scripts/contract-checks/frozen-imports.cjs . .",
    "check:exports": "node scripts/contract-checks/exports.cjs",
    "check:tsc-by-owner": "node scripts/contract-checks/tsc-by-owner.mjs",
    "check:ownership": "tsx scripts/gen-ownership.ts --check",
    "check:ratchets": "tsx scripts/ratchet-baseline.ts --check",
    "check:pure": "npm run check:constants && npm run check:catalog && npm run check:images && npm run check:track && npm run check:smoke && npm run check:ownership",
    "ownership:generate": "tsx scripts/gen-ownership.ts",
    "ratchet:baseline": "tsx scripts/ratchet-baseline.ts",
    "decisions:index": "tsx scripts/decisions-index.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@vercel/analytics": "^2.0.1",
    "jose": "^6.2.12",
    "next": "^14.2.35",
    "nextjs-toploader": "^3.9.17",
    "prettier": "^3.9.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.15",
    "prisma": "^5.22.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "browserslist": [
    "chrome >= 91",
    "edge >= 91",
    "firefox >= 90",
    "safari >= 15",
    "ios_saf >= 15",
    "not dead",
    "not op_mini all"
  ]
}
