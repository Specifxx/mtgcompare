{
  "name": "opcompare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "import": "tsx scripts/import.ts",
    "import:catalog": "IMPORT_STORES=0 tsx scripts/import.ts",
    "probe:stores": "tsx scripts/probe-stores.ts",
    "icons": "tsx scripts/gen-icons.ts",
    "health:stores": "tsx scripts/store-health.ts",
    "audit:inbox": "tsx scripts/audit-inbox.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@vercel/analytics": "^2.0.1",
    "jose": "^6.2.12",
    "next": "^14.2.35",
    "nextjs-toploader": "^3.9.17",
    "prettier": "^3.9.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.15",
    "prisma": "^5.22.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "browserslist": [
    "chrome >= 91",
    "edge >= 91",
    "firefox >= 90",
    "safari >= 15",
    "ios_saf >= 15",
    "not dead",
    "not op_mini all"
  ]
}
