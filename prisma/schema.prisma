// MTG Compare: the PRIVATE-STATE schema (contract section 2.2, FROZEN; owner WP01a). ONE Neon database, DATABASE_URL, 28 models.
// The public catalogue (sets, cards, oracles, prices, units, store offers, sealed, price history and every precomputed public view) is NOT here: it lives in the PRIVATE data repository as sharded versioned JSON
// (sections 2.9 and 12, src/lib/data/plane). This schema keeps ONLY accounts, billing, member data, inbox, counters, ops rows, the private demand analytics and the eBay data that must never leave the database.
// Products are referenced by plain integers (productId = Card.id / Sealed.id) with NO foreign key; existence is checked against the plane (cardExists / sealedExists), and the importer never deletes a catalogue row,
// so a stored id always resolves. Public pages never read this database (tests/public-no-neon.test.ts): it is touched by member pages, /api routes, the card-view beacon (sampled, batched), and the Actions jobs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Accounts and Premium (ported from RiftCompare) ──────────────────────────
// Sign-in is Google / Discord OAuth only, with a signed JWT cookie (no session
// table). Entitlement is a date: premiumUntil, extended (never shortened) by
// the Stripe webhook and the daily reconcile, and premiumTier from the Price.
model User {
  id               String    @id @default(cuid())
  email            String    @unique
  displayName      String
  avatarUrl        String?
  emailVerified    DateTime?
  googleId         String?
  discordId        String?
  isAdmin          Boolean   @default(false)
  premiumUntil     DateTime?
  premiumTier      String    @default("premium")
  stripeCustomerId String?
  createdAt        DateTime  @default(now())
  lastLoginAt      DateTime?

  // Wave 2 (RiftCompare parity).
  lastActiveAt       DateTime?
  activeDays         Int       @default(0)
  preferredCountry   String?
  signupSource       String?
  collectionShareId  String?   @unique
  basketPrefs        Json? // { minCondition: "nm"|"lp"|"any", region?: string, trackedOnly?: boolean }
  welcomeEmailSentAt DateTime?

  priceAlerts   PriceAlert[]
  sealedWatches SealedWatch[]
  deckWatches   DeckWatch[]
  notifications Notification[]
  collection    CollectionCard[]

  @@index([googleId])
  @@index([discordId])
  @@index([stripeCustomerId])
}

// Small key/value settings written by jobs and read by the admin: alert-run counters (alerts.*), db.footprint.<week>, ebay.paused, ebay.observeOnly, email. It holds NO import state any more:
// the gate, the hold memory, the guard counters and the pointer live in the data repository (latest.json, status.json).
model Meta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model PriceReport {                           // + finish; listingTitle stays nullable and is no longer filled (Offer has no title)
  id              String   @id @default(cuid())
  productId       Int
  finish          Int      @default(0) @db.SmallInt
  kind            String
  source          String
  market          String
  storeName       String
  shownPriceCents Int?
  currency        String?
  listingTitle    String?
  listingUrl      String?
  issue           String
  claimedCents    Int?
  note            String?
  userId          String?
  page            String?
  status          String   @default("NEW")
  createdAt       DateTime @default(now())

  @@index([status, createdAt])
  @@index([source, createdAt])
  @@index([productId])
}

model StoreSuggestion {
  id        String   @id @default(cuid())
  storeName String
  storeUrl  String // https://<bare host>
  country   String // a MARKETS code or "OTHER"
  note      String?
  userId    String?
  status    String   @default("pending") // pending | added | rejected
  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([storeUrl])
}

model Feedback {
  id            String    @id @default(cuid())
  userId        String?
  rating        Int? // 1–5
  message       String // may be "" when only a rating was given
  displayName   String? // stored only with consentPublic
  consentPublic Boolean   @default(false)
  page          String?
  email         String? // optional reply address; never public
  source        String    @default("page") // page | widget
  status        String    @default("NEW") // NEW | APPROVED | HIDDEN | SPAM
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([createdAt])
  @@index([status, publishedAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String // the visitor typed it so the owner can reply by hand
  subject   String?
  category  String   @default("OTHER") // PAYMENT | ACCOUNT | PRICE_OR_STORE | OTHER
  message   String
  userId    String?
  status    String   @default("NEW") // NEW | DONE
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

// ── Beacons (ported from RiftCompare) ───────────────────────────────────────
// RESTORED (owner addendum 2026-10-08: "click events" stay in Neon; OP deleted the feature on 2026-10-05 because each click was a write). POST /api/click records a SAMPLED row (CLICK_LOG, CLICK_SAMPLE_RATE),
// batched per instance and flushed like the view counter; rows older than 90 days are swept by the daily alerts script; /admin/clicks reads it.
model ClickEvent {
  id        String   @id @default(cuid())
  retailer  String // data-retailer: "store:<key>", "tcgplayer", "ebay", "ebay_search", "buy_list" …
  page      String // data-page, or the first path segment: "card", "sealed", "price-guide", "footer" …
  slug      String? // card / sealed slug when the click came from its page
  country   String // US AU UK CA SG EU
  userId    String?
  entry     String? // first-touch bucket ("search", "social", "direct" …)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([retailer, createdAt])
}

// One row per click on a Plus/Premium call to action (PlanButton, the Pricing
// links, the slide-in → /api/premium/click), read only by /admin/premium.
// `surface` is validated against lib/nudge-surface.ts before it is written.
model PremiumClick {
  id        String   @id @default(cuid())
  surface   String // "nav:header", "gate:buy-list", "nudge:slidein", "checkout" …
  tier      String? // the tier the surface was selling: plus | premium
  source    String   @default("click") // "click" | "checkout"
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model PriceAlert {                            // + finish; the unique key is widened; cardId is a plain productId (no FK)
  id                 String    @id @default(cuid())
  email              String
  userId             String?
  cardId             Int
  finish             Int       @default(0) @db.SmallInt // EXPLICIT unit: set from the selected finish tab, or headFinish at creation, never "follow the headline"
  market             String    @default("US")
  lastPriceCents     Int?
  lowestEmailedCents Int?
  targetCents        Int?
  targetEmailedCents Int?
  startPriceCents    Int?
  unsubToken         String
  createdAt          DateTime  @default(now())
  lastNotifiedAt     DateTime?
  lastFlaggedAt      DateTime?
  confirmSentAt      DateTime?
  soldOutAt          DateTime?
  soldOutRuns        Int?
  dropAnchorCents    Int?
  pendingLowCents    Int?
  snoozedUntil       DateTime?
  user               User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([email, cardId, finish, market])
  @@index([cardId])
  @@index([email])
  @@index([unsubToken])
  @@index([userId])
}

// An address that asked for no more alert email (one-click unsubscribe-all).
model AlertMute {
  email   String   @id
  mutedAt DateTime @default(now())
  source  String?
}

// A watched sealed product (Plus). RiftCompare keys these by groupKey; OP has
// one Sealed row per product, so it is Sealed.id.
model SealedWatch {
  id               String    @id @default(cuid())
  userId           String
  email            String
  market           String    @default("US")
  sealedId         Int
  targetCents      Int?
  lastPriceCents   Int?
  lastInStock      Boolean?
  soldOutAt        DateTime?
  lastEmailedCents Int?
  lastNotifiedAt   DateTime?
  lastFlaggedAt    DateTime?
  lastAtRrp        Boolean?
  snoozedUntil     DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sealedId, market])
  @@index([userId])
  @@index([email])
}

// A saved deck list whose delivered basket total is re-checked (Premium).
model DeckWatch {
  id               String    @id @default(cuid())
  userId           String
  market           String    @default("US")
  name             String
  listText         String
  region           String?
  trackedOnly      Boolean?
  targetCents      Int?
  minCondition     String?
  lastTotalCents   Int?
  lastCheckedAt    DateTime?
  lastEmailedCents Int?
  lastNotifiedAt   DateTime?
  lastFlaggedAt    DateTime?
  snoozedUntil     DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// In-app notifications (the bell). Written only through notify() in
// src/lib/notifications.ts.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// The portfolio / binder: one row per (card printing, condition, foil).
model CollectionCard {
  id               String   @id @default(cuid())
  userId           String
  cardId           Int                                     // productId, no FK
  setId            Int?                                    // denormalised from the plane at write time (the portfolio's per-set views filter on it)
  condition        String   @default("NM")
  isFoil           Boolean  @default(false)
  quantity         Int      @default(1)
  costBasisCents   Int?
  costBasisIsTotal Boolean  @default(false)
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId, condition, isFoil])
  @@index([userId])
  @@index([cardId])
  @@index([userId, setId])
}

// Small named counters (support ticket numbers and the like).
model Counter {
  key   String @id
  value Int
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  market         String    @default("US")
  source         String?
  createdAt      DateTime  @default(now())
  unsubToken     String?   @unique
  lastEditionKey String?
  welcomeSentAt  DateTime?
}

// "Tell me when this set (or this card) is out." setSlug is Set.slug ("op-15");
// scope is "set" or a Card.id as a string.
model SetReleaseAlert {
  id                String    @id @default(cuid())
  email             String
  setSlug           String
  scope             String    @default("set")
  market            String    @default("US")
  source            String?
  unsubToken        String
  createdAt         DateTime  @default(now())
  confirmSentAt     DateTime?
  singlesNotifiedAt DateTime?
  restockNotifiedAt DateTime?

  @@unique([email, setSlug, scope])
  @@index([setSlug])
  @@index([unsubToken])
}

model PublishedDeck {                         // the commander (and partner) of a Commander deck; identity is a WUBRG mask; lines carry finish
  id              String   @id @default(cuid())
  slug            String   @unique
  userId          String?
  authorName      String?
  title           String
  description     String?
  format          String   @default("commander")      // FORMATS key or "casual"
  commanderCardId Int
  commanderName   String
  commanderSlug   String                              // the commander's Oracle.slug
  partnerCardId   Int?
  partnerName     String?
  identity        Int      @default(0) @db.SmallInt   // WUBRG mask of the commander(s)
  list            String
  lines           Json                                // [{ cardId, qty, finish?: 0 | 1 }]
  cardIds         Int[]
  cardCount       Int
  publishedTotals Json
  source          String   @default("user")
  status          String   @default("live")
  createdAt       DateTime @default(now())

  @@index([status, createdAt])
  @@index([commanderSlug])
  @@index([userId, createdAt])
}

// A frozen, shareable Rising Cards view (/rising/s/[token]).
model RisingSnapshot {
  id        String   @id @default(cuid())
  token     String   @unique
  scope     String
  title     String
  data      Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model SupportTicket {
  id        String   @id @default(cuid())
  number    Int      @unique
  userId    String?
  email     String
  name      String
  category  String   @default("OTHER")
  subject   String
  message   String
  status    String   @default("OPEN")
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

// One row per run of a job, written LAST inside try/catch with a 10 second timeout (a Neon outage never fails an import). status.json.runs in the data repository is the source of truth for the admin's
// "last import result"; this table keeps the long history and the per-store summary array (summary.stores[]) that /admin/store-health reads.
model ImportRun {
  id         Int       @id @default(autoincrement())
  kind       String                           // "full" | "catalog" | "overlay" | "stores" | "ebay" | "bootstrap" | "squash"
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  summary    Json?                            // ImportSummaryV1 (6.1)

  @@index([kind, finishedAt])
}

model EbayTrack {                             // replaces EbayCheck. Unit of work = an ORACLE NAME (singles) or a sealed product
  ref       String                            // "o:<oracleNo>" for a single's name (the plane's public oracle ordinal), "p:<productId>" for sealed, "n:<fold(name)>" for a product with no oracle
  market    Int       @db.SmallInt
  tier      Int       @db.SmallInt            // 0 C (no calls) 1 A 2 B 3 sealed 4 banner-only
  score     Float     @db.Real
  banner    Boolean   @default(false)         // in the chase pool
  checkedAt DateTime?                         // set only after a COMPLETED search
  dueAt     DateTime?
  matched   Boolean   @default(false)

  @@id([ref, market])
  @@index([dueAt])
}

model EbayBest {                              // cheapest raw listing per tracked UNIT and market that the job matched. Display-only: never ranked, never in alerts or baskets
  productId  Int
  finish     Int      @db.SmallInt            // the unit the title was matched to (finish words); never inferred from the headline
  market     Int      @db.SmallInt
  priceCents Int                              // ITEM price; postage separate
  shipCents  Int?
  itemId     String                           // eBay item id digits; the URL is rebuilt with the current campaign at render
  checkedAt  DateTime                         // age label source (licence: 6 h rule)

  @@id([productId, finish, market])
  @@index([checkedAt])
}

model EbayPanel {                             // the card page's listing panel: one row per (product, market); listings carry `finish`; slabs inside `graded`
  productId Int
  market    Int      @db.SmallInt
  checkedAt DateTime
  listings  Json                              // <= 8 entries { finish, priceCents, shipCents, currency, itemId, title, image, rank }
  graded    Json?                             // <= 6 entries { grader, grade, ... }; never an Offer; never seller identity

  @@id([productId, market])
  @@index([checkedAt])
}

model EbayBanner {                            // ONE row: BannerPayloadV1, <= 100 KB, written only by the eBay job
  key       String   @id                      // "v1"
  payload   Json
  updatedAt DateTime @updatedAt
}

model EbayLedger {                            // one row per quota window (ebay-brief section 7)
  windowKey    String    @id                  // UTC date of the quota window START
  cap          Int
  claimed      Int       @default(0)
  spent        Int       @default(0)
  limit        Int?
  resetAt      DateTime?
  blockedUntil DateTime?
  samples      Json?
  runs         Json?
  breakdown    Json?
  config       Json?
  updatedAt    DateTime  @updatedAt
}

// Popularity counters: the ONLY per-request write of public traffic. SAMPLED (1 in VIEW_BEACON_SAMPLE, default 10), batched in the instance, flushed at most every VIEW_FLUSH_MINUTES (default 30) in ONE statement,
// never from a crawler, never awaited by a render (view-beacon.ts). Free-plan compute is 400 awake hours a month: every isolated burst of queries costs its 5-minute idle timeout. cardId is a productId (no table to point at).
model CardStat {
  cardId       Int       @id
  searchCount  Int       @default(0)
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
}

// One row per UTC day: the running totals of every card with activity at the end of that day ({ "<cardId>": [searches, views] }). Demand Finder and Rising Cards (Premium) read these; they are NEVER published (the OP design wrote them to the public data branch).
model DemandDay {
  day  String @id            // "2026-10-07"
  data Json                  // top 3,000 cards by activity, about 40 KB a day
}
